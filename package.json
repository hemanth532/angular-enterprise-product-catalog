{
  "name": "enterprise-product-catalog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve enterprise-product-catalog --configuration development",
    "start:mf": "ng serve enterprise-product-catalog --configuration development --extra-webpack-config webpack.config.js",
    "start:prod": "npx http-server ./dist/enterprise-product-catalog -p 8080 --silent",
    "build": "ng build enterprise-product-catalog --configuration production",
    "build:mf": "ng build enterprise-product-catalog --configuration production --extra-webpack-config webpack.config.js",
    "build:prod": "ng build enterprise-product-catalog --configuration production",
    "test": "ng test enterprise-product-catalog --watch=false",
    "lint": "ng lint enterprise-product-catalog",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\"",
    "e2e": "echo \"No e2e target configured in angular.json. Add an e2e builder or use Cypress/Protractor.\" && exit 1"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0",
    "@angular-architects/module-federation": "^15.0.0",
    "ngx-build-plus": "^15.0.0",
    "@opentelemetry/api": "^1.5.0",
    "@opentelemetry/sdk-trace-web": "^1.9.0",
    "@opentelemetry/instrumentation-fetch": "^0.34.0",
    "@opentelemetry/instrumentation-document-load": "^0.34.0",
    "@opentelemetry/sdk-metrics": "^1.9.0",
    
    "ngx-logger": "^5.0.0"
    ,
    "path-browserify": "^1.0.1"
  },
  "browser": {
    "path": false
  },
  "optionalDependencies": {},
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/language-service": "^22.0.8",
    "@angular/build": "^22.0.8",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^20.11.0",
    "jasmine-core": "^6.3.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~6.0.0",
    "prettier": "^3.0.0",
    "eslint": "^9.8.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "http-server": "^14.0.0"
  }
}
